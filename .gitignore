# ===========================================
# SITUS - GITIGNORE
# ===========================================
# Updated: February 4, 2026
# Production-ready ignore rules

# ===========================================
# 1. Dependencies
# ===========================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ===========================================
# 2. Environment Files (NEVER COMMIT)
# ===========================================
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Exception: Template file for reference
!.env.example

# ===========================================
# 3. Next.js Build Output
# ===========================================
/.next/
/out/
/build
/dist/

# ===========================================
# 4. Testing & Coverage
# ===========================================
/coverage
/playwright-report/
/playwright/.cache/
/playwright/.auth/
/test-results/
/blob-report/
*.spec.js.snap

# ===========================================
# 5. Databases (Local Development Only)
# ===========================================
# Match by extension, not by name. These were listed individually, so every SQLite file the
# workflows create at the repo root showed up as untracked and one commit away from being
# added: mobile-audit.db, e2e-test.db, e2e-smoke.db, ci-smoke.db, ci-build.db. No .db file has
# ever been tracked here, so a blanket pattern loses nothing and closes the gap.
*.db
*.db-journal
*.db-wal
*.db-shm
tmp/

# ===========================================
# 6. TypeScript
# ===========================================
*.tsbuildinfo
next-env.d.ts

# ===========================================
# 7. Logs
# ===========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ===========================================
# 8. Operating System Files
# ===========================================
.DS_Store
*.pem
Thumbs.db
desktop.ini

# ===========================================
# 9. IDE & Editors
# ===========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ===========================================
# 10. Security & Monitoring Reports
# ===========================================
security-report.json

# ===========================================
# 11. Claude Code agent worktrees (temp)
# ===========================================
.claude/worktrees/
security-reports/
load-tests/reports/

# ===========================================
# 11. Build Artifacts & Docker
# ===========================================
situs_local_image.tar
situs_image.tar
/lib/generated/prisma

# ===========================================
# 12. Temporary & Local Files
# ===========================================
verify-output.txt
eslint-output.txt
test-output.txt
test-results.txt
final-test.txt
*-output.txt
*_output.txt
*-results.txt
.vercel

# Runtime exchange-rate cache — lib/exchange.ts writes this with a 24h TTL and
# refetches when it is absent. A committed copy is stale by definition.
/.cache/

# ===========================================
# 13. Legacy/Deprecated
# ===========================================
.eslintrc.cjs
.eslintrc.json
eslint.config.cjs

# Design-award capture output (local evidence, not source)
.design-award/

# Claude Code personal settings (auto-merge/watch authority, not team-shared)
.claude/settings.local.json

# Responsive audit harness output (regenerated per run).
# Globbed, not just the default name: AUDIT_OUT_DIR takes any directory, and a desktop pass
# written to `audit-desktop/` landed in `prettier --check` as four style violations.
audit-report/
audit-*/

# Document storage root (DOCUMENT_STORAGE_PATH). Runtime landlord/tenant documents —
# archived receipt PDFs land here the moment a receipt reaches "emitted". Never source,
# and committing it would publish real records.
uploads/
