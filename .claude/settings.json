{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/graphify.sh\" hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/graphify.sh\" hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/graphify.sh\" hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(CLAUDE_CODE_REMOTE=true ./.claude/hooks/session-start.sh)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npm run type-check)",
      "Bash(npm run lint)",
      "Bash(npm run verify:ci)",
      "Bash(npm test)",
      "Bash(npm audit *)",
      "Bash(npx prisma generate)",
      "Bash(npx tsc --noEmit)",
      "mcp__github__pull_request_read",
      "mcp__github__get_job_logs",
      "Bash(npm run hygiene)",
      "Bash(npm run docs:check)",
      "Bash(node scripts/check-docs.js)",
      "Bash(npm run i18n:check:strict)",
      "Bash(npm run lint:colors)",
      "Bash(npm run currency:check)",
      "Bash(npm run actions:check)",
      "Bash(graphify query *)",
      "Bash(graphify explain *)",
      "Bash(graphify path *)",
      "Bash(npm run graph)"
    ]
  }
}
