{
  "name": "situs",
  "version": "1.24.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-version-sync.js --write",
    "build": "next build",
    "prestart": "node scripts/prestart.js",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "verify": "npm run type-check && npm test",
    "verify:ci": "npm run type-check && npm run lint && npm run format:check && npm run hygiene && npm test",
    "verify:no-native": "node scripts/verify-no-native.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:setup": "prisma db push && prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "security:scan": "node scripts/security-scan.js",
    "validate-env": "node scripts/validate-env.js",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:fix": "npm audit fix",
    "security:zap": "node scripts/zap-scan.js",
    "security:all": "npm run security:scan && npm run security:audit",
    "load:smoke": "node scripts/load-test.js smoke",
    "load:test": "node scripts/load-test.js full",
    "load:stress": "node scripts/stress-test.js",
    "user:delete": "node scripts/delete-user.js",
    "db:check": "node scripts/check-db.js",
    "i18n:check": "node scripts/check-translations.js",
    "i18n:check:strict": "node scripts/check-translations.js --strict",
    "lint:colors": "node scripts/check-color-tokens.js --strict",
    "pwa:icons": "node scripts/generate-pwa-icons.js",
    "prepare": "husky",
    "docs:check": "node scripts/check-docs.js",
    "currency:check": "node scripts/check-currency-literals.js",
    "actions:check": "python3 scripts/check-action-manifests.py",
    "hygiene": "npm run docs:check && npm run i18n:check:strict && npm run lint:colors && npm run currency:check && npm run css:check && npm run actions:check && npm run version:check",
    "css:check": "node scripts/check-class-contract.mjs --strict",
    "audit:selftest": "node scripts/mobile-audit.selftest.mjs",
    "audit:local": "node scripts/audit-server.mjs",
    "version:sync": "node scripts/check-version-sync.js --write",
    "version:check": "node scripts/check-version-sync.js"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sendgrid/mail": "^8.1.6",
    "@types/leaflet": "^1.9.22",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "file-type": "^22.0.2",
    "framer-motion": "^12.43.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.37.0",
    "next": "^16.3.3",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.1",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.2"
  },
  "optionalDependencies": {
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/deep-eql": "^4.0.2",
    "@types/estree": "^1.0.9",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26",
    "@types/pako": "^2.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/raf": "^3.4.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-v8": "^4.1.11",
    "artillery": "^2.0.34",
    "eslint": "^10",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "react-i18next": "^17.0.12",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vite": "^8",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@opentelemetry/api": "1.4.1",
    "@opentelemetry/core": ">=2.8.0",
    "@hono/node-server": ">=1.19.13",
    "hono": ">=4.12.18",
    "protobufjs": ">=8.6.6",
    "postcss": ">=8.5.18",
    "valibot": ">=1.4.2",
    "uuid": ">=14.0.0",
    "esbuild": ">=0.28.1",
    "axios": ">=1.18.1",
    "brace-expansion": ">=5.0.9",
    "fast-uri": ">=3.1.4",
    "sharp": ">=0.35.3",
    "playwright-core": "1.62.1",
    "find-my-way": ">=9.7.0",
    "nanoid": "^3.3.17",
    "socket.io-parser": ">=4.2.7",
    "undici": "^7.29.0",
    "dompurify": ">=3.4.13",
    "deepmerge-ts": ">=8.0.1",
    "artillery": {
      "js-yaml": "3.15.1"
    }
  }
}
