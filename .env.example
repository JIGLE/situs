# ===========================================
# SITUS ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to `.env` or `.env.local` for local development
# For production, set these via your deployment platform's environment variables
#
# Required variables are marked with [REQUIRED]
# Optional variables are marked with [OPTIONAL]

# ===========================================
# Core Runtime Configuration
# ===========================================

# [REQUIRED] Application environment
# Values: development, production, test
NODE_ENV=production

# [REQUIRED] Full URL where the app is hosted (no trailing slash)
# Local: http://localhost:3000
# Production: https://your.domain.com
NEXTAUTH_URL=https://your.domain.com

# [OPTIONAL] Secret for signing session tokens (min 32 characters)
# Required when authentication is enabled (`ENABLE_OAUTH=true` or using sessions).
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-secure-secret-min-32-chars

# [OPTIONAL in development, REQUIRED in production] SQLite database connection string
# - Leave unset in development to use mock data (read-only fixtures)
# - Set to use real Prisma database in development for full-stack testing
# Local development: file:./dev.db
# Production (Docker): file:/app/data/situs.sqlite — /app/data is the image's volume
# DATABASE_URL=file:/app/data/situs.sqlite

# ===========================================
# Authentication - Google OAuth (optional)
# ===========================================
# Only required when you opt-in to OAuth by setting `ENABLE_OAUTH=true`.
# Get credentials at: https://console.cloud.google.com/apis/credentials

# [OPTIONAL] Google OAuth Client ID (required if `ENABLE_OAUTH=true`)
GOOGLE_CLIENT_ID=

# [OPTIONAL] Google OAuth Client Secret (required if `ENABLE_OAUTH=true`)
GOOGLE_CLIENT_SECRET=

# ===========================================
# Email Service - SMTP
# ===========================================
# Sends rent reminders and lease alerts. Absent, the app runs and simply sends
# nothing.
#
# SMTP rather than a vendor SDK, because every provider speaks it — so changing
# provider is these four values, not a code change. Suggested: Brevo, which is
# EU-based (relevant under GDPR: no third-country transfer to reason about) and
# free to 300/day. Resend, MailerSend, SMTP2GO and Amazon SES all work equally.
#
# SendGrid users are not stranded: point these at smtp.sendgrid.net, user
# `apikey`, pass your API key. Note Twilio retired SendGrid's free tier in July
# 2025 — it is now roughly 20 USD a month minimum, which is why the default moved.
#
# Brevo: smtp-relay.brevo.com : 587, user = your login, pass = an SMTP key
# (an SMTP key, not the REST API key — they are different credentials).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# [OPTIONAL] Default "from" address. Must be on a domain you have verified with
# the provider, or mail will be rejected or land in spam.
FROM_EMAIL=noreply@situs.app

# [OPTIONAL] Shared secret for the delivery-event webhook (/api/webhooks/brevo).
# REQUIRED if you want bounce and delivery tracking: the route answers 503 while
# it is unset, and 401 without it.
#
# Brevo does NOT sign its webhooks — no HMAC, no signature header — so unlike
# SendGrid's ECDSA-signed events, this secret is the only thing authenticating
# the caller. Generate with: openssl rand -hex 32
# Configure it in Brevo as an `Authorization: Bearer <secret>` header.
BREVO_WEBHOOK_SECRET=

# ===========================================
# Server Binding Configuration
# ===========================================

# [OPTIONAL] Hostname to bind the server to
# Default: 0.0.0.0 (all interfaces)
HOSTNAME=0.0.0.0

# [OPTIONAL] Port to run the server on
# Default: 3000
PORT=3000

# [RECOMMENDED behind a proxy] How many reverse proxies sit in front of this app.
# Each proxy APPENDS to X-Forwarded-For, so the only entries a client cannot forge are the
# last N — this says how far from the right to read the caller's real IP. A Cloudflare
# tunnel or a single nginx counts as 1. Default: 1.
# Set 0 when the container is reachable directly, which ignores the header entirely.
# Getting this wrong lets a caller spoof the header and choose their own rate-limit bucket.
# TRUSTED_PROXY_COUNT=1

# Prestart control flags
# SKIP_PRESTART=true will skip all prestart checks (useful for platforms that manage lifecycle)
SKIP_PRESTART=false
# When true, enforce HOSTNAME/PORT validation during prestart
PRESTART_CHECK_HOSTPORT=false
# When true, prestart will exit with non-zero on sqlite preparation/validation failures
# (Flag removed - prestart now continues startup and operators must perform explicit DB init).

# ===========================================
# Database & Initialization
# ===========================================

# [OPTIONAL] Bearer secret, in production, for the database init endpoint
# (/api/debug/db/init). Unset, the endpoint answers 403 in production.
# INIT_SECRET=

# [OPTIONAL] Bearer token for the counter endpoint, /api/metrics (Prometheus). In
# production it answers 403 without `Authorization: Bearer $METRICS_TOKEN`, and always
# while this is unset. It needs no session, so use a strong random value
# (openssl rand -hex 32). It opens nothing but these counters.
# METRICS_TOKEN=

# [OPTIONAL] Reset database on startup (DANGEROUS - data loss!)
# Only use for development or fresh deployments
RESET_DB=false

# ===========================================
# PII Field Encryption
# ===========================================

# [REQUIRED in production] AES-256-GCM key for encrypting PII at rest
# (IBAN, tax ID / NIF, phone number — see lib/utils/pii-encryption.ts).
# The app REFUSES TO START in production without it, because the alternative is
# writing tenant IBANs and NIFs to disk in plaintext behind one log line. To run
# without encryption anyway, set ALLOW_UNENCRYPTED_PII=true and accept the risk.
# Omitting it in local dev is fine — it is a no-op there.
# Generate: openssl rand -hex 32  (must be exactly 64 hex characters)
# After setting this in an existing deployment, run:
#   node scripts/backfill-pii-encryption.js
# to encrypt rows that were written before the key was configured.
# PII_ENCRYPTION_KEY=

# [OPTIONAL] Checksum for database backup verification
DB_BACKUP_CHECKSUM=

# [OPTIONAL] Database schema management — both default to 'true'.
# `npm run prestart` (which the container runs before `node server.js`) calls
# scripts/ensure-sqlite.js, which:
#   - AUTO_DB_INIT      — runs `prisma db push` when the SQLite file has no tables at all
#   - AUTO_DB_SCHEMA_SYNC — runs an additive `prisma db push` on every start, so new columns
#                           from an upgrade land without a manual step
# Set either to 'false' to manage the schema yourself.
# AUTO_DB_INIT=true
# AUTO_DB_SCHEMA_SYNC=true

# ===========================================

# Debug & Safety Gates
# ===========================================
# IMPORTANT: Keep all of these FALSE in production!

# NOTE: The previous 'allow DB failure' bypass has been removed. On DB errors the
# health endpoint reports unhealthy; restart so prestart can initialise the schema,
# or POST /api/debug/db/init.

# [OPTIONAL] Demo login. When 'true', a demo credential pair signs in with role ADMIN.
# One flag, resolved on the server per request — the sign-in form and the credentials
# provider both read it, so they can no longer disagree. The old build-time
# NEXT_PUBLIC_ENABLE_DEMO_LOGIN is gone; remove it if a deployment still sets it.
# ENABLE_DEMO_LOGIN=false

# [OPTIONAL] Allow auth system reset (DANGEROUS)
ALLOW_AUTH_RESET=false

# [OPTIONAL] Allow environment variable inspection endpoint
ALLOW_ENV_CHECK=false

# [OPTIONAL] Enable debug logging
# Shows detailed logs in console and structured JSON in production
DEBUG=false

# [OPTIONAL] Minimum log level
# Values: debug, info, warn, error
LOG_LEVEL=info

# [DEV-ONLY] Enable dev fake auth for end-to-end UI testing (development only)
# Set to 'true' to enable auto-authenticated dev session:
# - Client-side: useSession() returns dev@example.local (id: "dev-user", role: "ADMIN")
# - Server-side: All protected API routes accept dev session (no database required)
# - Persistence: Session stored in sessionStorage, survives page refresh (24h TTL)
# - Database: NOT required when this is enabled
#
# WARNING: Do NOT enable in production or commit a .env with this set to true.
# Production builds must have NODE_ENV=production to ignore this setting.
# See docs/DEV_AUTH_SETUP.md for detailed setup guide.
NEXT_PUBLIC_DEV_AUTH=false

# ===========================================
# Bank Connection - Enable Banking (Optional)
# ===========================================
# PSD2 account information, the only way bank movements arrive. Without these
# the app still works, with payments recorded by hand: Settings > Integrations
# explains what to set, and no connect button is rendered, because a button
# that can only fail is worse than none.
#
# Enable Banking is the licensed AISP, so this instance needs no PSD2 licence
# and no eIDAS certificate of its own. Their "restricted production" mode is
# free and limited to bank accounts you whitelist as yours in their Control
# Panel — which is exactly the self-hosted case. Paid tiers are for products
# aggregating other people's accounts.
#
# Setup (https://enablebanking.com/docs/; the full walk-through is docs/truenas.md):
#   1. Register a Production application and whitelist your own accounts to
#      activate restricted mode. This is the one that connects a real bank.
#      A Sandbox application reaches only Enable Banking's Mock ASPSP, a
#      synthetic bank whose accounts you define yourself, so the connect
#      picker (Portugal and Spain) stays empty with one. Sandbox is for
#      exercising the transaction mapping, not for connecting your bank.
#   2. Save the RSA private key it generates — you get it once.
#   3. Add this exact callback to the application's allowed redirect URLs:
#        $NEXTAUTH_URL/api/bank/connections/callback
#      Enable Banking validates against that list, so a mismatch is refused.
#
# THE KEY: mount it as a file for any real deployment.
#
# An RSA-2048 PEM is ~1,700 characters, so it does not fit in a TrueNAS app-config
# value (limit 1,000) — and base64 makes it ~2,272, which is worse. The better
# reason is security: an env var holding a private key is readable from
# /proc/<pid>/environ, appears in process listings and crash dumps, and is echoed
# by anything that prints the environment. A mounted file with 0400 is not.
#
# Mount the .pem read-only into the container and point this at it:
ENABLE_BANKING_PRIVATE_KEY_FILE=

# The inline alternative, for a local run where a file mount is a nuisance. The
# file above wins if both are set. Base64 is accepted and detected (a PEM
# announces itself), but it is not a workaround for a length limit.
ENABLE_BANKING_PRIVATE_KEY=

# ===========================================
# Legal contact addresses (Optional)
# ===========================================
# Published on /privacy and /terms. They were hardcoded into the pages, which is
# wrong for self-hosted software: every operator's privacy page told their users
# to write to somebody else's mailbox.
#
# DATA_PROTECTION_EMAIL is also the address a PSD2 application registration asks
# for as its "email for data protection matters", and the provider will use it —
# so it has to be a mailbox somebody actually reads.
#
# Both default to privacy@situs.app when unset; LEGAL_CONTACT_EMAIL falls back to
# whatever DATA_PROTECTION_EMAIL resolves to.
DATA_PROTECTION_EMAIL=
LEGAL_CONTACT_EMAIL=

# ===========================================
# Scheduled Jobs
# ===========================================
# Shared secret for the /api/cron/* endpoints (notifications, data retention and
# the daily bank sync). Each returns 503 while this is unset, so nothing runs on
# a schedule until you set it and point a scheduler at them:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     https://your-host/api/cron/bank-sync
CRON_SECRET=

# Feature flags to opt-in to optional services (use 'true' to enable)
# When disabled, related integrations will be inactive and won't require secrets.
ENABLE_OAUTH=false

# ===========================================
# Build Metadata
# ===========================================
# Automatically set by CI/CD pipelines

# Application version (from package.json)
BUILD_VERSION=0.0.0

# Git commit hash
GIT_COMMIT=unknown

# Build timestamp (ISO 8601 format)
BUILD_TIME=2026-01-27T00:00:00Z

# --- Who may sign in -------------------------------------------------------
# Registration is CLOSED by default: the first account ever created owns the instance, and any
# other email is refused. Nothing to set for a single-operator install.
#
# This matters most when the app is publicly reachable — which a live bank connection requires,
# since the provider must reach /api/bank/connections/callback. Before this gate existed, any
# Google account that signed in was provisioned as an ADMIN.
#
# Comma-separated emails allowed IN ADDITION to existing users. Case-insensitive.
AUTH_ALLOWED_EMAILS=
