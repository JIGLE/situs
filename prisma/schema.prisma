  propertyId         String
  tenantId           String
  landlordNif        String // NIF/NIE of landlord
  tenantNif          String // NIF/NIE of tenant
  propertyReference  String // Referencia catastral
  municipalityCode   String // INE municipality code
  monthlyRent        Float
  contractStartDate  DateTime
  contractEndDate    DateTime?
  contractType       NRUAContractType
  isZonaTensionada   Boolean          @default(false)
  registrationNumber String? // Assigned by MITMA upon submission
  status             NRUAStatus       @default(pending)
  submittedAt        DateTime?
  confirmedAt        DateTime?
  rejectionReason    String?
  exportedXml        String? // Last exported XML payload
  metadata           String? // JSON for additional fields
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  lease    Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([leaseId])
  @@index([status])
  @@index([landlordNif])
  @@map("nrua_registrations")
}

enum NRUAContractType {
  VIVIENDA_HABITUAL // Primary residence
  VIVIENDA_TEMPORAL // Temporary housing
  VIVIENDA_TURISTICA // Tourist rental
}

enum NRUAStatus {
  pending // Not yet submitted
  submitted // Sent to Ventanilla Única
  confirmed // Accepted by MITMA
  rejected // Rejected — needs correction
  cancelled // Contract terminated, registration cancelled
}

// ========================================
// Portugal: Recibos de Renda Eletrónicos
// ========================================

model RentReceipt {
  id                String            @id @default(cuid())
  userId            String
  tenantId          String
  propertyId        String
  leaseId           String?
  receiptNumber     String            @unique // Sequential: RR/YYYY/NNNNNN
  landlordNif       String // NIF of landlord
  tenantNif         String? // NIF of tenant (optional for non-residents)
  propertyAddress   String // Full address of rented property
  cadasterReference String? // Referência matricial / Artigo matricial
  rentAmount        Float // Gross rent amount
  withholdingAmount Float             @default(0) // IRS withholding (retenção na fonte)
  netAmount         Float // Amount received after withholding
  paymentDate       DateTime // Date rent was paid
  receiptDate       DateTime // Date receipt is issued (must be within 5 days of payment)
  periodStart       DateTime // Rental period start (e.g. 1st of month)
  periodEnd         DateTime // Rental period end
  isRendaAcessivel  Boolean           @default(false) // Programa Renda Acessível
  taxRegime         String            @default("categoria_f") // "categoria_f" or "renda_acessivel"
  status            RentReceiptStatus @default(draft)
  atSubmissionId    String? // AT (Autoridade Tributária) submission ID
  submittedAt       DateTime?
  atResponseCode    String? // Response from AT webservice
  pdfPath           String? // Path to generated PDF
  xmlPayload        String? // Stored XML for AT submission
  // Situs receipt lifecycle (Migration C) — links this fiscal document back
  // to the reference-month ledger and to the lifecycle-managed Receipt that
  // triggered its emission.
  rentPeriodId      String?
  receiptId         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentPeriod RentPeriod? @relation(fields: [rentPeriodId], references: [id], onDelete: SetNull)
  receipt    Receipt?    @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([paymentDate])
  @@index([rentPeriodId])
  @@index([receiptId])
  @@map("rent_receipts")
}

// ── Situs tax connector layer (Migration C) ────────────────────────────────
// One row per (user, connector) — mode defaults to "review": every emission
// routes through human review before anything reaches a tax authority. The
// PT connector (lib/tax/connectors/pt-at.ts) wraps the existing
// rent-receipts-pt.ts numbering/XML/5-day-rule logic unchanged; ES is
// export-only today. TaxSubmissionLog is the append-only record the
// Intelligence Tax Connector dashboard (PR 10) reads.
model TaxAuthorityConnector {
  id               String    @id @default(cuid())
  userId           String
  country          String // ISO country code: "PT", "ES", …
  connectorKey     String // "pt_at_recibos" | "es_nrua_ventanilla" | …
  mode             String    @default("review") // sandbox|review|live
  status           String    @default("active") // active|disabled|error
  lastSubmissionAt DateTime?
  credentialsRef   String? // AES-256-GCM encrypted (lib/utils/pii-encryption)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionLogs TaxSubmissionLog[]

  @@unique([userId, connectorKey])
  @@index([userId])
  @@map("tax_authority_connectors")
}

model TaxSubmissionLog {
  id           String   @id @default(cuid())
  userId       String
  connectorId  String
  subjectType  String // rent_receipt|modelo179|nrua|tax_filing
  subjectId    String
  action       String // validate|submit|poll|cancel
  mode         String // sandbox|review|live — snapshot at call time
  status       String // success|error|pending
  responseCode String?
  responseBody String?
  createdAt    DateTime @default(now())

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connector TaxAuthorityConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([connectorId])
  @@index([subjectType, subjectId])
  @@map("tax_submission_logs")
}

enum RentReceiptStatus {
  draft // Generated but not submitted
  submitted // Sent to Portal das Finanças
  accepted // Accepted by AT
  rejected // Rejected by AT — needs correction
  cancelled // Anulado
}

// ========================================
// Tax Rule Store (Wave 3.1)
// Legislation-driven tax brackets and rates
// ========================================

model TaxRule {
  id            String   @id @default(cuid())
  country       String // "PT", "ES", "IT"
  regime        String // "STANDARD", "NHR", "IFICI", "AL", "RENDA_ACESSIVEL"
  ruleType      String // "INCOME_BRACKET", "DEDUCTIBLE_RATE", "WITHHOLDING_RATE", "FLAT_RATE"
  year          Int
  effectiveDate DateTime
  payload       String // JSON blob with the actual values
  sourceUrl     String? // Link to Diário da República / BOE
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([country, regime, ruleType, year])
  @@index([country, year])
  @@map("tax_rules")
}

model Modelo179Submission {
  id          String    @id @default(cuid())
  userId      String
  leaseId     String
  periodYear  Int
  status      String    @default("pending") // "pending" | "submitted" | "confirmed" | "rejected"
  submittedAt DateTime?
  atReference String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@unique([leaseId, periodYear])
  @@index([userId, periodYear])
  @@map("modelo179_submissions")
}

model TaxFiling {
  id                String   @id @default(cuid())
  userId            String
  year              Int
  country           String // "PT", "ES"
  regime            String // "STANDARD", "NHR", "IFICI", etc.
  propertyIds       String // JSON array of property IDs
  grossIncome       Float
  allowableExpenses Float
  taxableIncome     Float
  taxDue            Float
  effectiveRate     Float
  withholdingPaid   Float
  balanceDue        Float
  status            String   @default("draft") // "draft" | "final"
  notes             String? // JSON array from plugin
  payload           String // Full TaxCalculation JSON
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, country, regime])
  @@index([userId, year])
  @@map("tax_filings")
}
