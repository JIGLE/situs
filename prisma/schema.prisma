// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  imageConsent  Boolean   @default(false) // GDPR: Consent for displaying image
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Fiscal identity fields
  fiscalResidency String? // ISO country code: "PT", "ES", "IT", "FR", etc.
  nhrStatus       Boolean @default(false) // PT Non-Habitual Resident (pre-2024)
  nhrYear         Int? // Year NHR status was granted
  ificiStatus     Boolean @default(false) // PT IFICI regime (from 2024, replaces NHR)
  ificiYear       Int? // Year IFICI status was granted

  // MFA / TOTP fields
  totpSecret      String? // AES-256-GCM encrypted TOTP secret
  totpEnabled     Boolean   @default(false)
  totpBackupCodes String? // JSON array of hashed one-time backup codes
  totpVerifiedAt  DateTime? // Set when user completes MFA challenge; jwt callback reads this

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[] // GDPR logging

  // App-specific relations
  properties              Property[]
  buildings               Building[]
  tenants                 Tenant[]
  receipts                Receipt[]
  expenses                Expense[]
  rentPeriods             RentPeriod[]
  paymentAllocations      PaymentAllocation[]
  maintenanceTickets      MaintenanceTicket[]
  leases                  Lease[]
  correspondences         Correspondence[]
  correspondenceTemplates CorrespondenceTemplate[]
  owners                  Owner[]
  emailLogs               EmailLog[]
  documents               Document[]
  notifications           Notification[]
  invoices                Invoice[]
  maintenanceContacts     MaintenanceContact[]
  rentReceipts            RentReceipt[]
  settings                UserSettings?
  governmentVerifications GovernmentVerification[]
  modelo179Submissions    Modelo179Submission[]
  taxFilings              TaxFiling[]
  productEvents           ProductEvent[]
  subscription            Subscription?
  bankConnections         BankConnection[]
  bankAccounts            BankAccount[]
  bankTransactions        BankTransaction[]
  bankSyncJobs            BankSyncJob[]
  reconciliationRules     ReconciliationRule[]
  taxAuthorityConnectors  TaxAuthorityConnector[]
  taxSubmissionLogs       TaxSubmissionLog[]
  documentExtractions     DocumentExtraction[]
  inboundMessages         InboundMessage[]
}

model EmailLog {
  id                String    @id @default(cuid())
  userId            String?
  to                String
  from              String
  subject           String
  templateId        String?
  status            String
  messageId         String?
  error             String?
  sendgridMessageId String?   @unique
  lastEventType     String?
  lastEventAt       DateTime?
  failureReason     String?
  retryCount        Int       @default(0)
  sentAt            DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("email_logs")
}

model Owner {
  id                      String    @id @default(cuid())
  userId                  String
  name                    String
  email                   String    @unique
  phone                   String?
  address                 String?
  notes                   String?
  role                    OwnerRole @default(REGULAR) // Default role (can be overridden per property)
  taxResidenceCountry     String? // PT, ES, DK, etc.
  taxIdentificationNumber String? // NIF (PT), NIE/NIF (ES), CPR (DK)
  taxRate                 Float? // Optional override for tax rate
  portalAccess            Boolean   @default(true) // Access to owner portal
  emailNotifications      Boolean   @default(true) // Receive email notifications
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties          PropertyOwner[]
  documents           Document[]
  invoices            Invoice[]
  incomeDistributions IncomeDistributionShare[]

  @@map("owners")
}

model PropertyOwner {
  id                  String    @id @default(cuid())
  propertyId          String
  ownerId             String
  ownershipPercentage Float
  role                OwnerRole @default(REGULAR) // Property-specific role override
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, ownerId])
  @@map("property_owners")
}

model GovernmentVerification {
  id                String                         @id @default(cuid())
  userId            String
  provider          GovernmentVerificationProvider
  scope             GovernmentVerificationScope
  status            GovernmentVerificationStatus   @default(pending)
  externalReference String?
  verifiedFullName  String?
  verifiedTaxId     String?
  requestedAt       DateTime                       @default(now())
  authorizedAt      DateTime?
  completedAt       DateTime?
  expiresAt         DateTime?
  errorCode         String?
  errorMessage      String?
  metadata          String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyClaims PropertyVerificationClaim[]

  @@index([userId, status])
  @@index([provider, status])
  @@map("government_verifications")
}

model PropertyVerificationClaim {
  id                  String                          @id @default(cuid())
  verificationId      String
  propertyId          String
  claimType           PropertyVerificationClaimType   @default(ownership)
  status              PropertyVerificationClaimStatus @default(pending)
  ownershipPercentage Float?
  sourceReference     String?
  matchedAddress      String?
  registryData        String?
  verifiedAt          DateTime?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  verification GovernmentVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  property     Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([verificationId, propertyId])
  @@index([propertyId, status])
  @@index([verificationId])
  @@map("property_verification_claims")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  action       String
  details      String?
  // Situs: anchor entries to a record so per-entity audit trails (property
  // Audit tab) are a single indexed query. The service interface already
  // declared these; Migration A persists them.
  resourceType String?
  resourceId   String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Building {
  id        String   @id @default(cuid())
  userId    String
  name      String
  address   String?
  city      String?
  country   String?  @default("PT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([userId])
  @@map("buildings")
}

model Property {
  id              String  @id @default(cuid())
  userId          String
  name            String
  address         String
  // Enhanced address fields
  streetAddress   String?
  city            String?
  zipCode         String?
  country         String? @default("PT")
  latitude        Float?
  longitude       Float?
  addressVerified Boolean @default(false)
  // Building grouping
  buildingId      String?
  buildingName    String?

  building Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  type        PropertyType
  bedrooms    Int
  bathrooms   Int
  rent        Float
  status      PropertyStatus
  description String?
  image       String?

  // Multi-currency and income distribution
  currency              Currency              @default(EUR)
  incomeSplitMode       IncomeSplitMode       @default(POST_TAX)
  distributionFrequency DistributionFrequency @default(MONTHLY)
  createdByOwnerId      String? // Owner who created this property (auto managing owner)
  // Spain: Ley de Vivienda
  isZonaTensionada      Boolean               @default(false)
  cadasterReference     String? // Referencia catastral (ES) or artigo matricial (PT)
  // Fiscal / rental regime
  rentalRegime          String                @default("standard") // "standard" | "acessivel" | "al" | "short_term"
  propertyCountry       String                @default("PT") // ISO country code

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenants             Tenant[]
  receipts            Receipt[]
  owners              PropertyOwner[]
  expenses            Expense[]
  maintenance         MaintenanceTicket[]
  leases              Lease[]
  units               Unit[]
  documents           Document[]
  invoices            Invoice[]
  incomeDistributions IncomeDistribution[]
  rentReceipts        RentReceipt[]
  nruaRegistrations   NRUARegistration[]
  verificationClaims  PropertyVerificationClaim[]
  correspondences     Correspondence[]
  rentPeriods         RentPeriod[]
  inboundMessages     InboundMessage[]

  // Performance indexes
  @@index([userId])
  @@index([status])
  @@index([userId, status]) // Composite for property listing
  @@map("properties")
}

model Tenant {
  id            String        @id @default(cuid())
  userId        String
  name          String
  email         String        @unique
  phone         String
  propertyId    String?
  rent          Float
  leaseStart    DateTime
  leaseEnd      DateTime
  paymentStatus PaymentStatus @default(pending)
  lastPayment   DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Portal-link revocation epoch. Portal tokens are stateless signed JWTs, so before this there
  // was no way to invalidate one — a link forwarded to the wrong address, or a tenant who moved
  // out, stayed valid until it expired on its own up to 7 days later.
  //
  // Every token carries `iat`; verification rejects any token issued at or before this instant,
  // which revokes ALL outstanding links for the tenant in one write. Generating a new link
  // afterwards works normally, because its `iat` is later. Null means nothing was ever revoked.
  portalAccessRevokedAt DateTime?

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  property            Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  receipts            Receipt[]
  correspondences     Correspondence[]
  maintenance         MaintenanceTicket[]
  leases              Lease[]
  documents           Document[]
  invoices            Invoice[]
  paymentMethods      PaymentMethod[]
  paymentTransactions PaymentTransaction[]
  rentReceipts        RentReceipt[]
  nruaRegistrations   NRUARegistration[]
  rentPeriods         RentPeriod[]
  inboundMessages     InboundMessage[]

  // Performance indexes
  @@index([userId])
  @@index([propertyId])
  @@index([paymentStatus])
  @@index([userId, paymentStatus]) // Composite for overdue tenants
  @@map("tenants")
}

model Receipt {
  id             String        @id @default(cuid())
  userId         String
  tenantId       String
  propertyId     String
  leaseId        String?
  amount         Float
  date           DateTime
  type           ReceiptType
  status         ReceiptStatus @default(paid)
  description    String?
  // Situs reference-month workflow (Migration A). `status` keeps meaning the
  // MONEY state (paid|pending); `lifecycle` is the DOCUMENT state — legacy
  // rows self-backfill to "emitted" via the default.
  rentPeriodId   String?
  referenceMonth String? // "YYYY-MM" denormalized for queue/list display
  // draft|review|emitted|submitted|accepted|rejected|exported|voided — Zod-validated
  // (Migration C, lib/services/receipts/lifecycle.ts). Legacy rows self-backfill to "emitted".
  lifecycle      String        @default("emitted")
  source         String        @default("manual") // manual|automation
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentPeriod         RentPeriod?         @relation(fields: [rentPeriodId], references: [id], onDelete: SetNull)
  allocations        PaymentAllocation[]
  bankTransactions   BankTransaction[]
  rentReceiptFilings RentReceipt[]

  // Performance indexes for common queries
  @@index([userId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@index([date])
  @@index([userId, status, date]) // Composite index for insights queries
  @@index([rentPeriodId])
  @@index([lifecycle])
  @@map("receipts")
}

// Situs period ledger — the spine of the Rent Matrix and Current Period Status.
// year+month is the REFERENCE month (what the money is for), distinct from the
// payment date. `status` is persisted-derived: recomputed inside the same
// transaction as every allocation write (see lib/services/allocation).
model RentPeriod {
  id              String    @id @default(cuid())
  userId          String
  leaseId         String
  tenantId        String // denormalized — matrix/tenant queries must not join through Lease
  propertyId      String // denormalized — property-detail queries
  year            Int
  month           Int // 1–12
  dueDate         DateTime
  dueAmount       Float // snapshot of the lease rent at generation — survives adjustments
  allocatedAmount Float     @default(0) // materialized sum of non-reversed allocations
  paidAt          DateTime? // when the period became fully allocated
  status          String    @default("upcoming") // upcoming|due|overdue|partially_paid|paid|paid_late|waived
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  lease              Lease               @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  receipts           Receipt[]
  allocations        PaymentAllocation[]
  rentReceiptFilings RentReceipt[]

  @@unique([leaseId, year, month])
  @@index([userId, year, month])
  @@index([leaseId, status])
  @@index([propertyId, year])
  @@index([tenantId, status])
  @@map("rent_periods")
}

// Money → reference-month join. Reversals are SOFT (reversedAt) so history
// survives for audit. Bank/online-payment source columns arrive with the bank
// layer migration; a manual Receipt is the first supported source.
model PaymentAllocation {
  id             String    @id @default(cuid())
  userId         String
  rentPeriodId   String
  receiptId      String?
  amount         Float
  type           String    @default("rent") // rent|partial|overpayment_credit|adjustment
  allocatedAt    DateTime  @default(now())
  createdBy      String    @default("system") // system|user (manual override)
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime  @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rentPeriod RentPeriod @relation(fields: [rentPeriodId], references: [id], onDelete: Cascade)
  receipt    Receipt?   @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([rentPeriodId])
  @@index([receiptId])
  @@map("payment_allocations")
}

// ── Situs bank layer (Migration B) ─────────────────────────────────────────
// Manual/CSV import is the first-class source; PSD2 later is just a new
// `provider` value on BankConnection, not a schema change. Consent fields
// live on the connection (1:1 in practice). IBANs follow the repo PII
// pattern: AES-256-GCM ciphertext + SHA-256 hash column so matching and
// dedupe never require decryption.

model BankConnection {
  id               String    @id @default(cuid())
  userId           String
  provider         String    @default("manual") // manual|csv|psd2_<provider> later
  institutionName  String
  status           String    @default("active") // pending_consent|active|expired|revoked|error
  consentId        String?
  consentExpiresAt DateTime?
  consentScope     String?
  lastSyncAt       DateTime?
  metadata         String? // JSON — provider-specific settings
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts BankAccount[]
  syncJobs BankSyncJob[]

  @@index([userId])
  @@map("bank_connections")
}

model BankAccount {
  id           String   @id @default(cuid())
  connectionId String
  userId       String
  label        String
  iban         String? // AES-256-GCM encrypted (lib/utils/pii-encryption)
  ibanHash     String? // SHA-256 of normalized IBAN — matching without decryption
  ibanLast4    String?
  currency     String   @default("EUR")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connection   BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([connectionId, ibanHash])
  @@index([userId])
  @@map("bank_accounts")
}

// The inbox row. `fingerprint` makes imports idempotent: hash of
// account + amount + booking date + counterparty + reference — an exact
// re-import is rejected by the unique constraint before any matching runs.
// bookingDate = payment date; valueDate = settlement date (kept distinct).
model BankTransaction {
  id                   String    @id @default(cuid())
  userId               String
  bankAccountId        String
  syncJobId            String?
  externalId           String?
  fingerprint          String    @unique
  amount               Float // signed; negative = outflow/reversal
  currency             String    @default("EUR")
  bookingDate          DateTime
  valueDate            DateTime?
  counterpartyName     String?
  counterpartyIban     String? // encrypted
  counterpartyIbanHash String?
  reference            String?
  rawData              String? // JSON — original imported row
  status               String    @default("imported") // imported|auto_matched|needs_review|matched_confirmed|ignored|duplicate
  suggestedLeaseId     String? // advisory only — no FK so lease deletion never breaks the inbox
  matchConfidence      Float?
  matchReasons         String? // JSON — explainability: fired signals, warnings, duplicate hints
  duplicateOfId        String? // suspected fuzzy-duplicate original (advisory)
  receiptId            String? // rent Receipt created on match — the allocation entry point
  reversalOfId         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  syncJob     BankSyncJob?      @relation(fields: [syncJobId], references: [id], onDelete: SetNull)
  receipt     Receipt?          @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  reversalOf  BankTransaction?  @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals   BankTransaction[] @relation("TransactionReversal")

  @@index([userId, status])
  @@index([userId, bookingDate])
  @@index([bankAccountId, bookingDate])
  @@index([counterpartyIbanHash])
  @@map("bank_transactions")
}

model BankSyncJob {
  id           String    @id @default(cuid())
  userId       String
  connectionId String
  type         String    @default("csv_import") // csv_import|manual_entry|api_sync
  status       String    @default("completed") // pending|running|completed|failed
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  stats        String? // JSON — {imported, duplicates, autoMatched, needsReview, errors}
  error        String?

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([userId])
  @@index([connectionId])
  @@map("bank_sync_jobs")
}

// Rules run BEFORE confidence scoring (priority ascending). Confirmed manual
// matches offer "save as rule" — that is how sender IBANs get learned.
model ReconciliationRule {
  id            String    @id @default(cuid())
  userId        String
  name          String
  priority      Int       @default(100)
  isActive      Boolean   @default(true)
  condition     String // JSON — {field: iban_hash|counterparty_name|reference_regex|amount_range, op, value}
  action        String // JSON — {type: assign_lease|ignore, leaseId?}
  timesApplied  Int       @default(0)
  lastAppliedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
  @@map("reconciliation_rules")
}

model Expense {
  id              String    @id @default(cuid())
  userId          String
  propertyId      String
  unitId          String? // Optional: scope expense to a specific unit
  leaseId         String? // Optional: link expense to a lease period
  amount          Float
  date            DateTime
  category        String // ExpenseCategory value — validated by Zod, stored as string (SQLite)
  description     String?
  isDeductible    Boolean   @default(true) // Whether deductible for IRS/IRPF
  vendorName      String? // Supplier/vendor name (useful for invoice records)
  vendorVat       String? // Vendor NIF/VAT number for tax documentation
  // Situs deduction-evidence workflow: a real Document link + a tax review
  // state (receiptImage dropped PR 11 — no reads/writes remained, see the
  // 20260430000000-style consolidation migration for the drop).
  documentId      String?
  taxReviewStatus String? // pending_review|reviewed|flagged — Zod-validated
  // Recurring expense fields (Wave 2.4)
  isRecurring     Boolean   @default(false)
  recurrenceRule  String? // "monthly" | "quarterly" | "annual"
  recurrenceDay   Int? // Day of month to generate (1-28)
  recurrenceEnd   DateTime? // Stop generating after this date (null = indefinite)
  parentExpenseId String? // If this was auto-generated, points to the template expense
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  lease         Lease?    @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  parentExpense Expense?  @relation("RecurringExpenses", fields: [parentExpenseId], references: [id], onDelete: SetNull)
  childExpenses Expense[] @relation("RecurringExpenses")
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  // Performance indexes
  @@index([userId])
  @@index([propertyId])
  @@index([unitId])
  @@index([leaseId])
  @@index([date])
  @@index([category])
  @@index([isDeductible])
  @@index([isRecurring])
  @@index([parentExpenseId])
  @@map("expenses")
}

model MaintenanceTicket {
  id               String              @id @default(cuid())
  userId           String
  propertyId       String
  tenantId         String?
  unitId           String?
  title            String
  description      String
  status           MaintenanceStatus   @default(open)
  priority         MaintenancePriority @default(medium)
  category         String? // plumbing, electrical, structural, appliance, cleaning, other
  images           String // JSON string of image URLs
  cost             Float? // @deprecated — kept for backward compat; use estimatedCost
  estimatedCost    Float?
  actualCost       Float?
  scheduledDate    DateTime?
  dueDate          DateTime?
  assignedTo       String? // @deprecated — kept for backward compat; use vendorName
  vendorName       String?
  vendorPhone      String?
  invoiceRef       String?
  isTenantReport   Boolean             @default(false)
  resolvedAt       DateTime?
  // Situs Operations subtabs (PR 10b-1): Evidence tab flag + SLA due date.
  evidenceRequired Boolean             @default(false)
  slaDueAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  // Performance indexes
  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@index([priority])
  @@index([userId, status]) // Composite for open tickets
  @@map("maintenance_tickets")
}

model CorrespondenceTemplate {
  id        String       @id @default(cuid())
  name      String
  type      TemplateType
  subject   String
  content   String
  variables String // JSON string of variable names
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  /// NULL = system-owned: shipped with the product, readable by everyone, editable by nobody.
  /// Non-NULL = owned by that user, private to them. This column is what separates a statutory
  /// instrument (whose wording carries professional liability) from a landlord's own copy.
  userId String?

  /// Jurisdiction and language. A Portuguese statutory notice must be in Portuguese and must not
  /// be offered for a Spanish property. NULL on both = applies anywhere (operational templates).
  country String? // ISO 3166-1 alpha-2, matched against Property.propertyCountry
  locale  String? // BCP 47, one of the app's four catalogues

  /// Bumped on every edit. A sent letter pins the version it rendered from, so "which words went
  /// out" stays answerable after the template moves on.
  version Int @default(1)

  /// Set when a user copies a system template. Together these are the liability record: they say
  /// which instrument this descended from and at which revision it stopped being ours.
  derivedFromId      String?
  derivedFromVersion Int?

  // Relations
  correspondences Correspondence[]
  user            User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  derivedFrom     CorrespondenceTemplate?  @relation("TemplateLineage", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivatives     CorrespondenceTemplate[] @relation("TemplateLineage")

  @@index([userId])
  @@index([country, locale])
  @@map("correspondence_templates")
}

/// A served letter is evidence. Everything needed to prove what was sent lives on this row —
/// the rendered subject and content, plus a snapshot of the template's identity at render time —
/// so the record survives the template being edited, deleted, or forked afterwards.
model Correspondence {
  id         String               @id @default(cuid())
  userId     String
  templateId String?
  tenantId   String
  propertyId String?
  subject    String
  content    String
  status     CorrespondenceStatus @default(draft)
  sentAt     DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  /// Provenance, captured at render time and never updated afterwards. templateId above is a
  /// convenience link that may go NULL; these three answer "whose words were these?" on their own.
  templateNameSnapshot    String?
  templateVersionSnapshot Int?
  /// "system" if rendered from a locked statutory template, "user" if from the sender's own copy.
  /// This is the field a liability argument actually turns on.
  templateOriginSnapshot  String?

  // Relations
  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull, never Cascade: deleting a template must not destroy the record of letters sent from
  /// it. Under the previous Cascade, one landlord deleting a globally-shared template erased
  /// another landlord's proof of service.
  template CorrespondenceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@map("correspondence")
}

/// Mail that arrived FROM the outside world, via Brevo Inbound Parsing.
///
/// Deliberately not a `direction` column on Correspondence above. That model requires a
/// `tenantId`, and carries the template-provenance fields that decide a liability argument
/// about words we sent. Inbound mail arrives from an address that may match no tenant at all,
/// and it has no provenance to record because we did not write it. Two models, because they
/// answer two different questions.
///
/// SECURITY: nothing on this row is attributable to the person it claims to be from. Brevo
/// hands us whatever the sending server said. `spfResult`/`dkimResult` are the only evidence
/// here, and even they only speak for the sending *domain*.
model InboundMessage {
  id     String @id @default(cuid())
  userId String

  /// Envelope, as received. NOT proof of identity — see spfResult/dkimResult.
  fromAddress String
  fromName    String?
  /// The parse address it arrived at, e.g. rendas@reply.example.com.
  toAddress   String
  subject     String
  /// Plain text only. The HTML part is deliberately not stored: rendering attacker-authored
  /// markup inside the app is an XSS surface, and a stripped-to-text body is what the Inbox
  /// shows anyway. When a message carries only HTML, it is reduced to text on ingest.
  textBody    String

  /// RFC 5322 Message-ID. Unique because Brevo retries a failed delivery, and a retry must
  /// update the row it already wrote rather than produce a second copy of the same email.
  rfcMessageId String? @unique
  inReplyTo    String?

  /// What Brevo's own checks reported, stored verbatim rather than reduced to a boolean: a
  /// dispute about who sent something is settled from the record, and "pass"/"fail"/"none"/
  /// "softfail" are not the same claim.
  spfResult  String?
  dkimResult String?

  /// A SUGGESTION, never a link. Set when the sender address matches exactly one tenant.
  /// `tenantId` is set only by an explicit human action in the Inbox.
  ///
  /// Weaker on purpose than the ≥0.85 auto-allocate the bank matcher uses: a movement's
  /// counterparty is asserted by the bank, and a From header is asserted by whoever sent the
  /// mail. Auto-linking on a forgeable header would file a stranger's message into a tenant's
  /// record, where it would then look like part of that tenancy's history.
  suggestedTenantId String?
  tenantId          String?
  propertyId        String?

  read       Boolean  @default(false)
  archived   Boolean  @default(false)
  receivedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  property    Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  attachments InboundAttachment[]

  @@index([userId, read])
  @@index([userId, receivedAt])
  @@index([userId, archived])
  @@map("inbound_messages")
}

/// A file that came in attached to an InboundMessage.
///
/// Held apart from `Document` on purpose. Anyone who learns the parse address can send us a
/// file; if those landed in Documents automatically, the Documents screen would be writable by
/// the public. Filing one into Documents is an explicit action, and `documentId` records that
/// it happened.
model InboundAttachment {
  id        String @id @default(cuid())
  messageId String

  /// The sender's filename, kept as a label to show. NEVER used to build a path — the stored
  /// file is named from a random id plus the magic-byte-detected extension.
  filename    String
  /// Detected from the file's own bytes, not from the Content-Type the sender claimed.
  mimeType    String
  fileSize    Int
  storagePath String

  /// Set when the user files this into Documents. Null means it lives only in the Inbox.
  documentId String?

  createdAt DateTime @default(now())

  message  InboundMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@map("inbound_attachments")
}

model Lease {
