// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  imageConsent  Boolean   @default(false) // GDPR: Consent for displaying image
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // MFA / TOTP fields
  totpSecret      String? // AES-256-GCM encrypted TOTP secret
  totpEnabled     Boolean   @default(false)
  totpBackupCodes String? // JSON array of hashed one-time backup codes
  totpVerifiedAt  DateTime? // Set when user completes MFA challenge; jwt callback reads this

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[] // GDPR logging

  // App-specific relations
  properties             Property[]
  buildings              Building[]
  tenants                Tenant[]
  receipts               Receipt[]
  expenses               Expense[]
  rentPeriods            RentPeriod[]
  paymentAllocations     PaymentAllocation[]
  leases                 Lease[]
  owners                 Owner[]
  emailLogs              EmailLog[]
  documents              Document[]
  notifications          Notification[]
  rentReceipts           RentReceipt[]
  settings               UserSettings?
  modelo179Submissions   Modelo179Submission[]
  productEvents          ProductEvent[]
  subscription           Subscription?
  bankConnections        BankConnection[]
  bankAccounts           BankAccount[]
  bankTransactions       BankTransaction[]
  bankSyncJobs           BankSyncJob[]
  reconciliationRules    ReconciliationRule[]
  taxAuthorityConnectors TaxAuthorityConnector[]
  taxSubmissionLogs      TaxSubmissionLog[]
}

model EmailLog {
  id                String    @id @default(cuid())
  userId            String?
  to                String
  from              String
  subject           String
  templateId        String?
  status            String
  messageId         String?
  error             String?
  sendgridMessageId String?   @unique
  lastEventType     String?
  lastEventAt       DateTime?
  failureReason     String?
  retryCount        Int       @default(0)
  sentAt            DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("email_logs")
}

model Owner {
  id                      String    @id @default(cuid())
  userId                  String
  name                    String
  email                   String    @unique
  phone                   String?
  address                 String?
  notes                   String?
  role                    OwnerRole @default(REGULAR) // Default role (can be overridden per property)
  taxResidenceCountry     String? // PT, ES, DK, etc.
  taxIdentificationNumber String? // NIF (PT), NIE/NIF (ES), CPR (DK)
  taxRate                 Float? // Optional override for tax rate
  portalAccess            Boolean   @default(true) // Access to owner portal
  emailNotifications      Boolean   @default(true) // Receive email notifications
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties          PropertyOwner[]
  documents           Document[]
  incomeDistributions IncomeDistributionShare[]

  @@map("owners")
}

model PropertyOwner {
  id                  String    @id @default(cuid())
  propertyId          String
  ownerId             String
  ownershipPercentage Float
  role                OwnerRole @default(REGULAR) // Property-specific role override
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, ownerId])
  @@map("property_owners")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  action       String
  details      String?
  // Situs: anchor entries to a record so per-entity audit trails (property
  // Audit tab) are a single indexed query. The service interface already
  // declared these; Migration A persists them.
  resourceType String?
  resourceId   String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Building {
  id        String   @id @default(cuid())
  userId    String
  name      String
  address   String?
  city      String?
  country   String?  @default("PT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([userId])
  @@map("buildings")
}

model Property {
  id              String  @id @default(cuid())
  userId          String
  name            String
  address         String
  // Enhanced address fields
  streetAddress   String?
  city            String?
  zipCode         String?
  country         String? @default("PT")
  latitude        Float?
  longitude       Float?
  addressVerified Boolean @default(false)
  // Building grouping
  buildingId      String?
  buildingName    String?

  building Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  type        PropertyType
  bedrooms    Int
  bathrooms   Int
  rent        Float
  status      PropertyStatus
  description String?
  image       String?

  // Multi-currency and income distribution
  currency              Currency              @default(EUR)
  distributionFrequency DistributionFrequency @default(MONTHLY)
  createdByOwnerId      String? // Owner who created this property (auto managing owner)
  // Spain: Ley de Vivienda
  isZonaTensionada      Boolean               @default(false)
  cadasterReference     String? // Referencia catastral (ES) or artigo matricial (PT)
  // Fiscal / rental regime
  rentalRegime          String                @default("standard") // "standard" | "acessivel" | "al" | "short_term"
  propertyCountry       String                @default("PT") // ISO country code

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenants             Tenant[]
  receipts            Receipt[]
  owners              PropertyOwner[]
  expenses            Expense[]
  leases              Lease[]
  units               Unit[]
  documents           Document[]
  incomeDistributions IncomeDistribution[]
  rentReceipts        RentReceipt[]
  nruaRegistrations   NRUARegistration[]
  rentPeriods         RentPeriod[]

  // Performance indexes
  @@index([userId])
  @@index([status])
  @@index([userId, status]) // Composite for property listing
  @@map("properties")
}

model Tenant {
  id            String        @id @default(cuid())
  userId        String
  name          String
  email         String        @unique
  phone         String
  propertyId    String?
  rent          Float
  leaseStart    DateTime
  leaseEnd      DateTime
  paymentStatus PaymentStatus @default(pending)
  lastPayment   DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  property          Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  receipts          Receipt[]
  leases            Lease[]
  documents         Document[]
  rentReceipts      RentReceipt[]
  nruaRegistrations NRUARegistration[]
  rentPeriods       RentPeriod[]

  // Performance indexes
  @@index([userId])
  @@index([propertyId])
  @@index([paymentStatus])
  @@index([userId, paymentStatus]) // Composite for overdue tenants
  @@map("tenants")
}

model Receipt {
  id             String        @id @default(cuid())
  userId         String
  tenantId       String
  propertyId     String
  leaseId        String?
  amount         Float
  date           DateTime
  type           ReceiptType
  status         ReceiptStatus @default(paid)
  description    String?
  // Situs reference-month workflow (Migration A). `status` keeps meaning the
  // MONEY state (paid|pending); `lifecycle` is the DOCUMENT state — legacy
  // rows self-backfill to "emitted" via the default.
  rentPeriodId   String?
  referenceMonth String? // "YYYY-MM" denormalized for queue/list display
  // draft|review|emitted|submitted|accepted|rejected|exported|voided — Zod-validated
  // (Migration C, lib/services/receipts/lifecycle.ts). Legacy rows self-backfill to "emitted".
  lifecycle      String        @default("emitted")
  source         String        @default("manual") // manual|automation
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentPeriod         RentPeriod?         @relation(fields: [rentPeriodId], references: [id], onDelete: SetNull)
  allocations        PaymentAllocation[]
  bankTransactions   BankTransaction[]
  rentReceiptFilings RentReceipt[]

  // Performance indexes for common queries
  @@index([userId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@index([date])
  @@index([userId, status, date]) // Composite index for insights queries
  @@index([rentPeriodId])
  @@index([lifecycle])
  @@map("receipts")
}

// Situs period ledger — the spine of the Rent Matrix and Current Period Status.
// year+month is the REFERENCE month (what the money is for), distinct from the
// payment date. `status` is persisted-derived: recomputed inside the same
// transaction as every allocation write (see lib/services/allocation).
model RentPeriod {
  id              String    @id @default(cuid())
  userId          String
  leaseId         String
  tenantId        String // denormalized — matrix/tenant queries must not join through Lease
  propertyId      String // denormalized — property-detail queries
  year            Int
  month           Int // 1–12
  dueDate         DateTime
  dueAmount       Float // snapshot of the lease rent at generation — survives adjustments
  allocatedAmount Float     @default(0) // materialized sum of non-reversed allocations
  paidAt          DateTime? // when the period became fully allocated
  status          String    @default("upcoming") // upcoming|due|overdue|partially_paid|paid|paid_late|waived
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  lease              Lease               @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  receipts           Receipt[]
  allocations        PaymentAllocation[]
  rentReceiptFilings RentReceipt[]

  @@unique([leaseId, year, month])
  @@index([userId, year, month])
  @@index([leaseId, status])
  @@index([propertyId, year])
  @@index([tenantId, status])
  @@map("rent_periods")
}

// Money → reference-month join. Reversals are SOFT (reversedAt) so history
// survives for audit. Bank/online-payment source columns arrive with the bank
// layer migration; a manual Receipt is the first supported source.
model PaymentAllocation {
  id             String    @id @default(cuid())
  userId         String
  rentPeriodId   String
  receiptId      String?
  amount         Float
  type           String    @default("rent") // rent|partial|overpayment_credit|adjustment
  allocatedAt    DateTime  @default(now())
  createdBy      String    @default("system") // system|user (manual override)
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime  @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rentPeriod RentPeriod @relation(fields: [rentPeriodId], references: [id], onDelete: Cascade)
  receipt    Receipt?   @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([rentPeriodId])
  @@index([receiptId])
  @@map("payment_allocations")
}

// ── Situs bank layer (Migration B) ─────────────────────────────────────────
// Manual/CSV import is the first-class source; PSD2 later is just a new
// `provider` value on BankConnection, not a schema change. Consent fields
// live on the connection (1:1 in practice). IBANs follow the repo PII
// pattern: AES-256-GCM ciphertext + SHA-256 hash column so matching and
// dedupe never require decryption.

model BankConnection {
  id               String    @id @default(cuid())
  userId           String
  provider         String    @default("manual") // manual|csv|psd2_<provider> later
  institutionName  String
  status           String    @default("active") // pending_consent|active|expired|revoked|error
  consentId        String?
  consentExpiresAt DateTime?
  consentScope     String?
  lastSyncAt       DateTime?
  metadata         String? // JSON — provider-specific settings
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts BankAccount[]
  syncJobs BankSyncJob[]

  @@index([userId])
  @@map("bank_connections")
}

model BankAccount {
  id           String   @id @default(cuid())
  connectionId String
  userId       String
  label        String
  iban         String? // AES-256-GCM encrypted (lib/utils/pii-encryption)
  ibanHash     String? // SHA-256 of normalized IBAN — matching without decryption
  ibanLast4    String?
  currency     String   @default("EUR")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connection   BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([connectionId, ibanHash])
  @@index([userId])
  @@map("bank_accounts")
}

// The inbox row. `fingerprint` makes imports idempotent: hash of
// account + amount + booking date + counterparty + reference — an exact
// re-import is rejected by the unique constraint before any matching runs.
// bookingDate = payment date; valueDate = settlement date (kept distinct).
model BankTransaction {
  id                   String    @id @default(cuid())
  userId               String
  bankAccountId        String
  syncJobId            String?
  externalId           String?
  fingerprint          String    @unique
  amount               Float // signed; negative = outflow/reversal
  currency             String    @default("EUR")
  bookingDate          DateTime
  valueDate            DateTime?
  counterpartyName     String?
  counterpartyIban     String? // encrypted
  counterpartyIbanHash String?
  reference            String?
  rawData              String? // JSON — original imported row
  status               String    @default("imported") // imported|auto_matched|needs_review|matched_confirmed|ignored|duplicate
  suggestedLeaseId     String? // advisory only — no FK so lease deletion never breaks the inbox
  matchConfidence      Float?
  matchReasons         String? // JSON — explainability: fired signals, warnings, duplicate hints
  duplicateOfId        String? // suspected fuzzy-duplicate original (advisory)
  receiptId            String? // rent Receipt created on match — the allocation entry point
  reversalOfId         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  syncJob     BankSyncJob?      @relation(fields: [syncJobId], references: [id], onDelete: SetNull)
  receipt     Receipt?          @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  reversalOf  BankTransaction?  @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals   BankTransaction[] @relation("TransactionReversal")

  @@index([userId, status])
  @@index([userId, bookingDate])
  @@index([bankAccountId, bookingDate])
  @@index([counterpartyIbanHash])
  @@map("bank_transactions")
}

model BankSyncJob {
  id           String    @id @default(cuid())
  userId       String
  connectionId String
  type         String    @default("csv_import") // csv_import|manual_entry|api_sync
  status       String    @default("completed") // pending|running|completed|failed
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  stats        String? // JSON — {imported, duplicates, autoMatched, needsReview, errors}
  error        String?

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([userId])
  @@index([connectionId])
  @@map("bank_sync_jobs")
}

// Rules run BEFORE confidence scoring (priority ascending). Confirmed manual
// matches offer "save as rule" — that is how sender IBANs get learned.
model ReconciliationRule {
  id            String    @id @default(cuid())
  userId        String
  name          String
  priority      Int       @default(100)
  isActive      Boolean   @default(true)
  condition     String // JSON — {field: iban_hash|counterparty_name|reference_regex|amount_range, op, value}
  action        String // JSON — {type: assign_lease|ignore, leaseId?}
  timesApplied  Int       @default(0)
  lastAppliedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
  @@map("reconciliation_rules")
}

model Expense {
  id              String    @id @default(cuid())
  userId          String
  propertyId      String
  unitId          String? // Optional: scope expense to a specific unit
  leaseId         String? // Optional: link expense to a lease period
  amount          Float
  date            DateTime
  category        String // ExpenseCategory value — validated by Zod, stored as string (SQLite)
  description     String?
  isDeductible    Boolean   @default(true) // Whether deductible for IRS/IRPF
  vendorName      String? // Supplier/vendor name (useful for invoice records)
  vendorVat       String? // Vendor NIF/VAT number for tax documentation
  // Situs deduction-evidence workflow: a real Document link + a tax review
  // state (receiptImage dropped PR 11 — no reads/writes remained, see the
  // 20260430000000-style consolidation migration for the drop).
  documentId      String?
  taxReviewStatus String? // pending_review|reviewed|flagged — Zod-validated
  // Recurring expense fields (Wave 2.4)
  isRecurring     Boolean   @default(false)
  recurrenceRule  String? // "monthly" | "quarterly" | "annual"
  recurrenceDay   Int? // Day of month to generate (1-28)
  recurrenceEnd   DateTime? // Stop generating after this date (null = indefinite)
  parentExpenseId String? // If this was auto-generated, points to the template expense
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  lease         Lease?    @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  parentExpense Expense?  @relation("RecurringExpenses", fields: [parentExpenseId], references: [id], onDelete: SetNull)
  childExpenses Expense[] @relation("RecurringExpenses")
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  // Performance indexes
  @@index([userId])
  @@index([propertyId])
  @@index([unitId])
  @@index([leaseId])
  @@index([date])
  @@index([category])
  @@index([isDeductible])
  @@index([isRecurring])
  @@index([parentExpenseId])
  @@map("expenses")
}

model Lease {
  id                  String      @id @default(cuid())
  userId              String
  propertyId          String
  tenantId            String
  unitId              String?
  startDate           DateTime
  endDate             DateTime
  monthlyRent         Float
  deposit             Float       @default(0)
  contractFile        Bytes? // Store PDF content as BLOB
  contractFileName    String?
  contractFileSize    Int?
  taxRegime           String? // 'portugal_rendimentos' or 'spain_inmuebles'
  status              LeaseStatus @default(active)
  autoRenew           Boolean     @default(false)
  renewalNoticeDays   Int         @default(60)
  // Portugal: Renda Acessível programme
  isRendaAcessivel    Boolean     @default(false)
  // Spain: Ley de Vivienda
  isZonaTensionada    Boolean     @default(false)
  priorContractRent   Float? // Previous contract rent (for rent cap validation)
  notes               String?
  // Renewal lifecycle
  renewalStatus       String? // null | "offered" | "accepted" | "declined" | "expired"
  renewalOfferedAt    DateTime?
  renewalRespondedAt  DateTime?
  renewalNotes        String?
  renewalProposedRent Float?
  renewalStartDate    DateTime?
  renewalEndDate      DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relations
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  property             Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit                 Unit?                 @relation(fields: [unitId], references: [id], onDelete: SetNull)
  nruaRegistrations    NRUARegistration[]
  expenses             Expense[]
  modelo179Submissions Modelo179Submission[]
  rentPeriods          RentPeriod[]

  @@index([userId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@index([userId, status])
  @@map("leases")
}

model Unit {
  id         String     @id @default(cuid())
  propertyId String
  number     String // Unit/apartment number
  floor      Int?
  sizeSqM    Float?
  bedrooms   Int?
  bathrooms  Int?
  status     UnitStatus @default(vacant)
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Relations
  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases    Lease[]
  documents Document[]
  expenses  Expense[]

  @@unique([propertyId, number])
  @@map("units")
}

model Document {
  id          String       @id @default(cuid())
  userId      String
  name        String
  description String?
  type        DocumentType
  mimeType    String
  storagePath String // File path or URL
  fileSize    Int

  // Polymorphic relations (nullable FKs)
  propertyId String?
  unitId     String?
  ownerId    String?
  tenantId   String?

  expiresAt DateTime? // Optional expiry for insurance policies, certificates, permits

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  owner    Owner?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  expenses Expense[] // Situs: deduction-evidence links (Expense.documentId)

  @@index([userId])
  @@index([propertyId])
  @@index([type])
  @@index([expiresAt])
  @@map("documents")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  entityType String? // 'Property', 'Lease', 'Tenant', etc.
  entityId   String? // ID of related entity
  read       Boolean          @default(false)
  payload    String? // JSON for additional data
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

// Payment System Models for Portugal/Spain

// Enums
enum PropertyType {
  apartment
  house
  condo
  townhouse
  commercial
  other
}

enum PropertyStatus {
  occupied
  vacant
  maintenance
}

enum PaymentStatus {
  paid
  overdue
  pending
}

enum ReceiptType {
  rent
  deposit
  maintenance
  other
}

enum ReceiptStatus {
  paid
  pending
}

enum UserRole {
  USER
  ADMIN
  MANAGER
}

enum EmailStatus {
  sent
  delivered
  bounced
  failed
}

enum LeaseStatus {
  active
  expired
  terminated
  pending
  draft
}

enum UnitStatus {
  vacant
  occupied
  maintenance
  reserved
}

enum DocumentType {
  contract
  invoice
  receipt
  photo
  floor_plan
  certificate
  other
}

/// Only values something actually writes. Five were dropped in the scope cutdown: four
/// (lease_expiring, payment_received, document_uploaded, nrua_registration) had no producer
/// anywhere and never had; inbound_message went with the mail inbox. Every value below is
/// written by lib/services/notifications/notification-automation.ts, except the two catch-alls.
/// Adding one back is a line here and a line in lib/utils/notification-labels.ts — cheaper than
/// carrying an enum whose members are aspirations.
enum NotificationType {
  payment_due
  payment_overdue
  rent_receipt_due
  lease_renewal_reminder
  system
  other
}

// Payment-specific enums

// ========================================
// New Models for Navigation Restructuring
// ========================================

// Income Distribution (with audit trail)
model IncomeDistribution {
  id                   String    @id @default(cuid())
  propertyId           String
  periodStart          DateTime
  periodEnd            DateTime
  totalIncome          Float
  totalExpenses        Float
  netIncome            Float
  currency             Currency  @default(EUR)
  version              Int       @default(1) // Incremented on recalculation
  calculatedByUserId   String
  recalculatedByUserId String?
  recalculatedAt       DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  property Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  shares   IncomeDistributionShare[]

  @@map("income_distributions")
}

// Individual owner shares from an income distribution
model IncomeDistributionShare {
  id                  String    @id @default(cuid())
  distributionId      String
  ownerId             String
  ownershipPercentage Float
  grossShare          Float // The owner's part of net income, before their own tax
  notifiedAt          DateTime?
  createdAt           DateTime  @default(now())

  // Relations
  distribution IncomeDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  owner        Owner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("income_distribution_shares")
}

// User Settings (preferences)
model UserSettings {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  theme                     String    @default("system") // light, dark, system
  language                  String    @default("en")
  defaultCurrency           Currency  @default(EUR)
  defaultTaxCountry         String? // PT, ES, DK
  emailNotifications        Boolean   @default(true)
  taxReminderNotifications  Boolean   @default(true)
  distributionNotifications Boolean   @default(true)
  // Server-side onboarding-checklist dismissal — was localStorage-only, so it
  // didn't survive across browsers/devices and couldn't be measured. Null
  // means "not dismissed" (or dismissed pre-migration, on an old client).
  onboardingDismissedAt     DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Lightweight product-analytics event sink (the app had landing-page funnel
/// tracking but no in-app product analytics).
/// Deliberately generic (name + JSON metadata) rather than a table per event
/// type — most core-loop facts (first property/tenant/lease/receipt, rent
/// marked paid, rent receipt issued) are already derivable retroactively from
/// existing tables' createdAt/status columns, so this sink is reserved for
/// signals that have no other home, e.g. "a reminder notification was clicked"
/// (as opposed to "a notification was marked read" via a bulk action).
model ProductEvent {
  id        String   @id @default(cuid())
  userId    String
  name      String
  metadata  String? // JSON
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, name])
  @@index([createdAt])
  @@map("product_events")
}

/// SaaS subscription state for the app itself (distinct from rent collection,
/// which reaches the ledger as a matched bank movement, not a card payment).
/// No row for a user means Free — a row is only created once a Checkout
/// Session completes (the pricing tiers were previously unbacked marketing
/// copy).
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(free)
  status               SubscriptionStatus @default(active)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

enum SubscriptionPlan {
  free
  pro
  business
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
}

// ========================================
// New Enums
// ========================================

enum OwnerRole {
  MANAGING // Full access to property management
  REGULAR // View-only access to income reports
}

enum Currency {
  EUR // Euro (Portugal, Spain)
  DKK // Danish Krone
  USD // US Dollar
  GBP // British Pound
}

enum DistributionFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

// ========================================
// Spain: Ley de Vivienda — Stressed Zones
// ========================================

model StressedZone {
  id                  String    @id @default(cuid())
  country             String    @default("ES")
  communityCode       String // Autonomous community code (e.g. "CAT", "MAD")
  communityName       String // "Cataluña", "Comunidad de Madrid"
  municipalityCode    String // INE municipality code
  municipalityName    String // e.g. "Barcelona", "Madrid"
  postalCodes         String? // JSON array of applicable postal codes (null = whole municipality)
  declaredDate        DateTime // Date zone was declared stressed
  expiresDate         DateTime? // Expiration (renewable every 3 years per Ley 12/2023 Art. 18)
  mitmaReferenceIndex Float? // Official MITMA rent reference index (€/m²/month)
  isActive            Boolean   @default(true)
  source              String? // "BOE", "DOGC", "BOCM", etc.
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([municipalityCode, communityCode])
  @@index([country, isActive])
  @@index([municipalityCode])
  @@map("stressed_zones")
}

// ========================================
// Spain: NRUA — Registro Único de Arrendamientos
// Ventanilla Única Digital (mandatory from 2026)
// ========================================

model NRUARegistration {
  id                 String           @id @default(cuid())
  leaseId            String
  propertyId         String
  tenantId           String
  landlordNif        String // NIF/NIE of landlord
  tenantNif          String // NIF/NIE of tenant
  propertyReference  String // Referencia catastral
  municipalityCode   String // INE municipality code
  monthlyRent        Float
  contractStartDate  DateTime
  contractEndDate    DateTime?
  contractType       NRUAContractType
  isZonaTensionada   Boolean          @default(false)
  registrationNumber String? // Assigned by MITMA upon submission
  status             NRUAStatus       @default(pending)
  submittedAt        DateTime?
  confirmedAt        DateTime?
  rejectionReason    String?
  exportedXml        String? // Last exported XML payload
  metadata           String? // JSON for additional fields
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  lease    Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([leaseId])
  @@index([status])
  @@index([landlordNif])
  @@map("nrua_registrations")
}

enum NRUAContractType {
  VIVIENDA_HABITUAL // Primary residence
  VIVIENDA_TEMPORAL // Temporary housing
  VIVIENDA_TURISTICA // Tourist rental
}

enum NRUAStatus {
  pending // Not yet submitted
  submitted // Sent to Ventanilla Única
  confirmed // Accepted by MITMA
  rejected // Rejected — needs correction
  cancelled // Contract terminated, registration cancelled
}

// ========================================
// Portugal: Recibos de Renda Eletrónicos
// ========================================

model RentReceipt {
  id                String            @id @default(cuid())
  userId            String
  tenantId          String
  propertyId        String
  leaseId           String?
  receiptNumber     String            @unique // Sequential: RR/YYYY/NNNNNN
  landlordNif       String // NIF of landlord
  tenantNif         String? // NIF of tenant (optional for non-residents)
  propertyAddress   String // Full address of rented property
  cadasterReference String? // Referência matricial / Artigo matricial
  rentAmount        Float // Gross rent amount
  withholdingAmount Float             @default(0) // IRS withholding (retenção na fonte)
  netAmount         Float // Amount received after withholding
  paymentDate       DateTime // Date rent was paid
  receiptDate       DateTime // Date receipt is issued (must be within 5 days of payment)
  periodStart       DateTime // Rental period start (e.g. 1st of month)
  periodEnd         DateTime // Rental period end
  isRendaAcessivel  Boolean           @default(false) // Programa Renda Acessível
  taxRegime         String            @default("categoria_f") // "categoria_f" or "renda_acessivel"
  status            RentReceiptStatus @default(draft)
  atSubmissionId    String? // AT (Autoridade Tributária) submission ID
  submittedAt       DateTime?
  atResponseCode    String? // Response from AT webservice
  pdfPath           String? // Path to generated PDF
  xmlPayload        String? // Stored XML for AT submission
  // Situs receipt lifecycle (Migration C) — links this fiscal document back
  // to the reference-month ledger and to the lifecycle-managed Receipt that
  // triggered its emission.
  rentPeriodId      String?
  receiptId         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentPeriod RentPeriod? @relation(fields: [rentPeriodId], references: [id], onDelete: SetNull)
  receipt    Receipt?    @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([paymentDate])
  @@index([rentPeriodId])
  @@index([receiptId])
  @@map("rent_receipts")
}

// ── Situs tax connector layer (Migration C) ────────────────────────────────
// One row per (user, connector) — mode defaults to "review": every emission
// routes through human review before anything reaches a tax authority. The
// PT connector (lib/tax/connectors/pt-at.ts) wraps the existing
// rent-receipts-pt.ts numbering/XML/5-day-rule logic unchanged; ES is
// export-only today. TaxSubmissionLog is the append-only record the
// Intelligence Tax Connector dashboard (PR 10) reads.
model TaxAuthorityConnector {
  id               String    @id @default(cuid())
  userId           String
  country          String // ISO country code: "PT", "ES", …
  connectorKey     String // "pt_at_recibos" | "es_nrua_ventanilla" | …
  mode             String    @default("review") // sandbox|review|live
  status           String    @default("active") // active|disabled|error
  lastSubmissionAt DateTime?
  credentialsRef   String? // AES-256-GCM encrypted (lib/utils/pii-encryption)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionLogs TaxSubmissionLog[]

  @@unique([userId, connectorKey])
  @@index([userId])
  @@map("tax_authority_connectors")
}

model TaxSubmissionLog {
  id           String   @id @default(cuid())
  userId       String
  connectorId  String
  subjectType  String // rent_receipt|modelo179|nrua
  subjectId    String
  action       String // validate|submit|poll|cancel
  mode         String // sandbox|review|live — snapshot at call time
  status       String // success|error|pending
  responseCode String?
  responseBody String?
  createdAt    DateTime @default(now())

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connector TaxAuthorityConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([connectorId])
  @@index([subjectType, subjectId])
  @@map("tax_submission_logs")
}

enum RentReceiptStatus {
  draft // Generated but not submitted
  submitted // Sent to Portal das Finanças
  accepted // Accepted by AT
  rejected // Rejected by AT — needs correction
  cancelled // Anulado
}

model Modelo179Submission {
  id          String    @id @default(cuid())
  userId      String
  leaseId     String
  periodYear  Int
  status      String    @default("pending") // "pending" | "submitted" | "confirmed" | "rejected"
  submittedAt DateTime?
  atReference String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@unique([leaseId, periodYear])
  @@index([userId, periodYear])
  @@map("modelo179_submissions")
}
