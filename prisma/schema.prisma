model Document {
  id          String       @id @default(cuid())
  userId      String
  name        String
  description String?
  type        DocumentType
  mimeType    String
  storagePath String // File path or URL
  fileSize    Int

  // Polymorphic relations (nullable FKs)
  propertyId String?
  unitId     String?
  ownerId    String?
  tenantId   String?

  expiresAt DateTime? // Optional expiry for insurance policies, certificates, permits

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  property           Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit               Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  owner              Owner?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  expenses           Expense[] // Situs: deduction-evidence links (Expense.documentId)
  extraction         DocumentExtraction?
  /// Set when a user files an inbound email attachment into Documents. The attachment row is
  /// the original; this is the copy they chose to keep.
  inboundAttachments InboundAttachment[]

  @@index([userId])
  @@index([propertyId])
  @@index([type])
  @@index([expiresAt])
  @@map("documents")
}

// Situs OCR sidecar (Migration D) — 1:1 with Document, leaves the hot
// Document model untouched. "mock" is the only engine today (no live OCR
// integration yet — same mock-first pattern as the bank/tax connector
// layers); classification proposes a document type + a linked entity for a
// human to confirm in the Review Required tab.
model DocumentExtraction {
  id               String    @id @default(cuid())
  documentId       String    @unique
  userId           String
  status           String    @default("pending") // pending|processing|completed|failed|review_required
  engine           String    @default("mock")
  confidence       Float?
  extractedFields  String? // JSON — engine-specific key/value proposals
  suggestedType    String? // proposed DocumentType value
  linkedEntityType String? // "tenant"|"property"|"lease"|"expense"
  linkedEntityId   String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("document_extractions")
}

model Invoice {
